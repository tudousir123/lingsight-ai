       Table: trial_metrics
Create Table: CREATE TABLE `trial_metrics` (
  `video_id` varchar(128) NOT NULL COMMENT '视频=试次标识，关联 videos.video_id（全库无外键，按约定 join）',
  `metric` varchar(32) NOT NULL COMMENT '指标名：dist_px|speed_px|valid_kp_ratio|in_pool_ratio（口径见 definition 列）',
  `algo_version` varchar(64) NOT NULL COMMENT '算法版本：重算发新版本不覆盖旧值（ADR-0003），当前 v1-polyline-ok-frames',
  `value` double DEFAULT NULL COMMENT '指标值；calc_status != ok 时为 NULL',
  `unit` varchar(16) NOT NULL COMMENT '单位：px | px/s | ratio',
  `calc_status` varchar(24) NOT NULL COMMENT '计算状态：ok | no_frames | no_ok_frames | insufficient_ok_frames | missing_pool_params',
  `ok_frames` int NOT NULL COMMENT '口径快照：该视频 status=ok 帧数',
  `total_frames` int NOT NULL COMMENT '口径快照：该视频全部帧数',
  `duration_s` double DEFAULT NULL COMMENT '口径快照：ok 帧时间跨度 MAX(time_s)-MIN(time_s)（秒，speed_px 分母）',
  `definition` varchar(255) NOT NULL COMMENT '指标口径一句话（行级自描述；结构化口径以语义层与 ADR-0003 为准）',
  `calculated_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '本行写入/更新时间（UTC）',
  PRIMARY KEY (`video_id`,`metric`,`algo_version`),
  KEY `idx_metric_version` (`metric`,`algo_version`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='试次级行为指标表（ADR-0003）：确定性 Python 从 frame_predictions 计算入库，SQL/LLM 不推导指标；长格式每视频每指标一行'
