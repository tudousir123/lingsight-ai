# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="LingSight AI"

# All values below are placeholders: copy this file to .env and change them.
# Never commit the real .env or any real credentials.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# MySQL (compose db service; matches the local water_maze server, mysql:8.4)
# Rotate the password in BOTH places below: the variables feed the containers,
# DATABASE_URL is read literally by host-run commands (uv run alembic/pytest).
MYSQL_ROOT_PASSWORD=changethis
MYSQL_PASSWORD=changethis
# Local dev port 3308 (host 3306/3307 are taken by the local MySQL containers)
DATABASE_URL=mysql+pymysql://app:changethis@localhost:3308/app?charset=utf8mb4

# Research catalog: host-network formal backend -> existing MySQL at 13306.
# Copy these five keys to the private production env (chmod 600); never commit it.
# Grant this account SELECT only on water_maze.*, with no roles/grant option.
RESEARCH_DB_HOST=127.0.0.1
RESEARCH_DB_PORT=13306
RESEARCH_DB_USER=lingsight_ro
RESEARCH_DB_NAME=water_maze
LINGSIGHT_RO_PASSWORD=

# Trial flow (#18-#23): optional local media roots (unset = material reported missing)
# Synthetic trial fixture served instead of the research database in the
# CI/dev compose stack (path inside the backend container).
TRIALS_FIXTURE_DIR=/app/backend/app/trials/fixtures
# TRIALS_VIDEOS_ROOT=/path/to/local/DATAS
# TRIALS_SOURCE_PREFIX=/volume1/DATAS
# TRIALS_OVERLAY_DIR=/path/to/inference_video
# TRIALS_SCENE_MARKERS_JSON=/path/to/scene_markers.json

# Personal research Agent gateway (service token stays on the server).
# A container must use a reachable private service address, not host loopback.
AGENT_BASE_URL=http://127.0.0.1:19100
AGENT_API_TOKEN=
# Only this ordinary account and platform admins may use the personal workspace.
AGENT_WORKSPACE_EMAIL=

# Private video inference service (no credentials committed)
INFERENCE_BASE_URL=http://127.0.0.1:19200
INFERENCE_API_TOKEN=
